<?xml version="1.0" encoding="utf-8"?>
<!--
  The feed's player has to be a TextureView, not the default SurfaceView.

  Pinch-zoom is implemented as a Compose graphicsLayer transform on the video
  rect, and a SurfaceView renders into its own window layer that sits outside
  the Compose hierarchy — it would ignore the transform, so the picture would
  stay put while the poster zoomed out from under it. A TextureView is drawn
  like any other view, so it scales with everything else.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view" />
